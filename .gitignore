# ===================== Mac系统垃圾文件 =====================
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
# ===================== Windows系统文件 =====================
Thumbs.db
ehthumbs.db
Desktop.ini
# ===================== VSCode编辑器缓存（前端常用） =====================
# 只忽略日志，保留团队配置文件；如果不需要共享配置，直接写 .vscode/
.vscode/*.log
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
# ===================== NPM/Yarn依赖包【最重要！不要上传】=====================
node_modules/
# 使用npm：提交 package‑lock.json，忽略其它包管理器锁文件
pnpm-lock.yaml
yarn.lock
# ===================== 编译打包产物dist，不需要提交 =====================
dist/
build/
output/
# ===================== 本地环境、日志、临时文件 =====================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 本地环境变量（里面可能存放密钥、token，严禁上传！）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# ===================== Vue / Vite 缓存 =====================
.idea/
*.swp
*.swo
.cache/
.vite/
# ===================== 其他临时文件 =====================
*.tmp
*.bak

# ========== Vite/Vue前端补充忽略项 ==========
*.tsbuildinfo
coverage/
.temp/
.tmp/
*.map
